# Copie para music-bot.env somente em deploys manuais. No deploy automatizado,
# o GitHub Actions gera esse arquivo a partir dos secrets do environment production.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Required specifically for Spotify playlists. Generate it with
# `node music-bot/scripts/spotify-authorize.js` and store it only as a secret.
SPOTIFY_REFRESH_TOKEN=
YOUTUBE_API_KEY=
# Opcional. O bot tenta o acesso público legado quando estiver vazio.
AUDIUS_API_KEY=
# Music is normalized by default; lower this if the community still finds it
# louder than voice (for example 0.10). Use 1 only for an unattenuated source.
MUSIC_VOLUME=0.15
MUSIC_LOUDNORM=1
