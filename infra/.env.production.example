# This file is copied to .env on the VPS. Never commit the real file.
API_DOMAIN=api.journeycalendar.site
TURN_DOMAIN=turn.journeycalendar.site
TURN_EXTERNAL_IP=54.207.16.236

# Use the Neon pooled connection string, including sslmode=require.
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require
TURN_SHARED_SECRET=replace-with-a-long-random-secret
TURN_REALM=turn.journeycalendar.site
TURN_URIS=turn:turn.journeycalendar.site:3478?transport=udp,turn:turn.journeycalendar.site:3478?transport=tcp
ALLOWED_ORIGINS=https://api.journeycalendar.site
MUSIC_BOT_TOKEN=replace-with-a-long-random-secret-used-only-by-the-music-bot
# Optional. Required only for Spotify track/playlist URL resolution.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
