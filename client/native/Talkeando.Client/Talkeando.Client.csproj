<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms is referenced only for System.Windows.Forms.Screen /
         SystemInformation (monitor geometry) and the System.Drawing GDI
         capture path in ScreenCapture.cs — no WinForms UI is shown. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Tupi</AssemblyName>
    <RootNamespace>Tupi.Client</RootNamespace>
    <ApplicationIcon>assets\tupi.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <!-- The feed is deliberately independent from GitHub's /releases/latest.
         That endpoint remains pinned to the final Inno "bridge" release so
         old clients can never attempt to consume a Velopack package. -->
    <TupiUpdateFeedUrl Condition="'$(TupiUpdateFeedUrl)' == ''">https://github.com/MrVitor0/tupi/releases/download/tupi-update-feed</TupiUpdateFeedUrl>
    <TupiLegacyMigrationSetupUrl Condition="'$(TupiLegacyMigrationSetupUrl)' == ''">https://github.com/MrVitor0/tupi/releases/download/tupi-update-feed/Tupi.Client-Setup.exe</TupiLegacyMigrationSetupUrl>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TupiLegacyBridge)' == 'true'">
    <DefineConstants>$(DefineConstants);TUPI_LEGACY_BRIDGE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- WebRTC (voice mesh + screen share) now runs inside WebView2's own
         Chromium/libwebrtc engine (client/ui/src/rtc.ts), not in native C#
         — see SDD/27-decisions.md ADR-009. SIPSorcery/SIPSorceryMedia.* and
         System.Windows.Forms/System.Drawing (GDI screen capture) are no
         longer needed here at all. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3485.44" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="Tupi.UpdateFeedUrl" Value="$(TupiUpdateFeedUrl)" />
    <AssemblyMetadata Include="Tupi.LegacyMigrationSetupUrl" Value="$(TupiLegacyMigrationSetupUrl)" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\ui\dist\**\*" Link="ui\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="tupi.settings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
