<Window x:Class="Tupi.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Tupi"
        Width="1280" Height="800" MinWidth="960" MinHeight="640"
        WindowState="Maximized"
        WindowStyle="None"
        Background="#1E1F22"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="36"
                  ResizeBorderThickness="6"
                  CornerRadius="0"
                  GlassFrameThickness="0"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- Base look for every titlebar button: flat, no default chrome, rounded
         hover fill. -->
    <Style x:Key="TitlebarButtonBase" TargetType="Button">
      <Setter Property="Foreground" Value="#B5BAC1" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#35373C" />
                <Setter Property="Foreground" Value="#DBDEE1" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.3" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Left-side history arrows -->
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource TitlebarButtonBase}">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#949BA4" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#35373C" />
                <Setter Property="Foreground" Value="#DBDEE1" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.3" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Minimize / maximize -->
    <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource TitlebarButtonBase}">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="36" />
    </Style>

    <!-- Close (red hover) -->
    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitlebarButtonBase}">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#F23F42" />
                <Setter Property="Foreground" Value="#FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="RootBorder" Background="#1E1F22">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="36" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- ===== custom title bar ===== -->
      <Grid Grid.Row="0" Background="#1E1F22">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- history arrows -->
        <StackPanel Grid.Column="0" Orientation="Horizontal"
                    VerticalAlignment="Center" Margin="8,0,0,0"
                    WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="BackButton" Style="{StaticResource NavButton}"
                  Content="&#xE72B;" IsEnabled="False" Click="Back_Click"
                  ToolTip="Voltar" />
          <Button x:Name="ForwardButton" Style="{StaticResource NavButton}"
                  Content="&#xE72A;" IsEnabled="False" Click="Forward_Click"
                  ToolTip="Avançar" Margin="2,0,0,0" />
        </StackPanel>

        <!-- centered app / community name (rest of the row is the drag handle) -->
        <StackPanel Grid.Column="1" Orientation="Horizontal"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" Text="Tupi"
                     Foreground="#B5BAC1" FontSize="12" FontWeight="SemiBold"
                     VerticalAlignment="Center" />
        </StackPanel>

        <!-- window controls -->
        <StackPanel Grid.Column="2" Orientation="Horizontal"
                    WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource CaptionButton}" Content="&#xE921;"
                  Click="Minimize_Click" ToolTip="Minimizar" />
          <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                  Click="MaxRestore_Click" ToolTip="Maximizar" />
          <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;"
                  Click="Close_Click" ToolTip="Fechar" />
        </StackPanel>
      </Grid>

      <!-- ===== app content ===== -->
      <wv2:WebView2 x:Name="WebView" Grid.Row="1" />
    </Grid>
  </Border>
</Window>
