{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talkeando.local/protocol/websocket-envelope-v1.schema.json",
  "title": "Talkeando WebSocket envelope v1",
  "type": "object",
  "required": ["v", "op", "data"],
  "properties": {
    "v": { "const": 1 },
    "op": { "type": "string", "pattern": "^[a-z]+(\\.[a-z_]+)+$" },
    "data": { "type": "object" }
  },
  "additionalProperties": false
}
